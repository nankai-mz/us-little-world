          "hint": "找封蜡背面的英文。"
        },
        {
          "name": "夜班出口",
          "kind": "door",
          "role": 1,
          "code": "831",
          "clue": "钥匙牌背面印着 831。",
          "hint": "最后的号码在钥匙牌上。"
        }
      ]
    },
