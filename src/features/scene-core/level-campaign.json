          "hint": "问海图上标的方位。"
        },
        {
          "name": "救生衣箱",
          "kind": "box",
          "role": 0,
          "code": "414",
          "clue": "失物登记里救生衣编号是 414。",
          "hint": "找失物登记表。"
        },
        {
          "name": "透镜座",
          "kind": "mirror",
          "role": 1,
          "code": "blue",
          "clue": "铭牌提示先把蓝片放上去，标注 blue。",
          "hint": "问需要哪种颜色的透镜。"
        },
        {
          "name": "灯室门",
          "kind": "door",
          "role": 0,
          "code": "706",
          "clue": "值夜人袖口缝着 706。",
          "hint": "值夜人留下了最后一组号码。"
        }
      ]
    },
