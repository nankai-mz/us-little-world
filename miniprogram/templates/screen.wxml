<template name="screen">
  <view class="page {{reduceMotion ? 'reduced-motion' : ''}}">
    <view
      wx:if="{{effectText}}"
      class="interaction-feedback feedback-{{effectType}}"
      aria-live="polite"
      >{{effectText}}</view
    >
    <view wx:if="{{!ready}}" class="auth">
      <view class="logo">us<text>✳</text></view
      ><view class="eyebrow">A PRIVATE LITTLE PLACE FOR TWO</view
      ><view class="auth-title">把日子过成<view>我们喜欢的样子。</view></view
      ><text class="subtitle">收藏平凡的瞬间，也期待未来的每一天。</text>
      <image class="auth-pet" src="/assets/pet-room.png" mode="aspectFit" />
      <view wx:if="{{!configured}}" class="notice"
        >开发准备：请在 config.ts 填写 CloudBase 环境 ID，在项目设置填写真实微信
        AppID，并部署 usApi 云函数。本机浏览器预览可先体验功能。</view
      >
      <view wx:if="{{authMode === 'welcome'}}" class="auth-actions"
        ><button class="primary" data-mode="create" bindtap="authMode">
          微信身份 · 创建双人空间</button
        ><button class="secondary" data-mode="join" bindtap="authMode">
          我有邀请码，加入对方</button
        ><button class="text-button" data-mode="recover" bindtap="authMode">
          已有备份？恢复我们的回忆
        </button></view
      >
      <view wx:else class="card auth-card"
        ><view class="section-title"
          >{{authMode === 'unlock' ? '欢迎回到我们的小世界' : authMode ===
          'create' ? '故事，从今天开始' : authMode === 'join' ?
          '走进对方的小世界' : '恢复我们的回忆'}}</view
        >
        <block wx:if="{{authMode === 'create'}}"
          ><text class="label">给空间起个名字</text
          ><input
            value="{{title}}"
            data-field="title"
            bindinput="input"
            maxlength="30"
          /><text class="label">恋爱开始日期</text
          ><picker
            mode="date"
            value="{{startDate}}"
            end="{{day}}"
            data-field="startDate"
            bindchange="input"
            ><view class="picker">{{startDate}}</view></picker
          ></block
        >
        <block wx:if="{{authMode === 'join'}}"
          ><text class="label">一次性邀请码</text
          ><input
            value="{{invite}}"
            data-field="invite"
            bindinput="input"
            placeholder="请向对方索取邀请码"
            maxlength="128"
        /></block>
        <block wx:if="{{authMode === 'recover'}}"
          ><text class="label">64 位恢复密钥</text
          ><textarea
            value="{{code}}"
            data-field="code"
            bindinput="input"
            maxlength="80"
            placeholder="恢复密钥只在本机处理"
          />
        </block>
        <text class="label"
          >{{authMode === 'recover' ? '设置新的' : '本机'}}解锁口令（至少 10
          位）</text
        ><input
          password
          value="{{password}}"
          data-field="password"
          bindinput="input"
          placeholder="口令不会发送到服务器"
          maxlength="200"
        />
        <button
          wx:if="{{authMode !== 'recover'}}"
          class="primary full"
          loading="{{busy}}"
          disabled="{{busy || !configured}}"
          bindtap="authenticate"
        >
          {{authMode === 'unlock' ? '打开小世界' : '安全地开始'}}</button
        ><button
          wx:else
          class="primary full"
          bindtap="restoreVault"
          loading="{{busy}}"
        >
          选择加密备份并恢复</button
        ><button class="text-button" data-mode="welcome" bindtap="authMode">
          返回
        </button>
        <button
          wx:if="{{authMode === 'unlock'}}"
          class="text-button"
          data-mode="recover"
          bindtap="authMode"
        >
          使用恢复密钥与备份
        </button>
      </view>
      <text class="fineprint"
        >继续即了解：仅你的微信身份用于访问控制，内容在设备上加密。密钥丢失后服务器无法恢复。请保存加密备份和恢复密钥。</text
      >
    </view>
    <block wx:else>
      <view class="error" wx:if="{{error}}">{{error}}</view
      ><view class="notice" wx:if="{{unreadable}}"
        >有 {{unreadable}} 条记录暂时无法解密，请检查密钥备份。</view
      ><view class="notice" wx:if="{{!hasSharedKey}}"
        >等待安全交换空间密钥。<text data-view="security" bindtap="navigate"
          >前往设备与安全 →</text
        ></view
      >
      <block wx:if="{{screen === 'home'}}"
        ><view class="eyebrow">LIFE IS BETTER WITH YOU</view
        ><view class="heading">把今天，写进我们的故事<text>✳</text></view
        ><text class="subtitle">平凡日子里的小小幸福，都值得好好收藏。</text>
        <view class="hero"
          ><image
            class="hero-flower"
            src="/assets/flower.png"
            mode="aspectFit"
          /><text class="eyebrow">♡ TWO OF US</text
          ><view class="avatars"
            ><view class="avatar">我</view><text>♡</text
            ><view class="avatar green">你</view></view
          ><text class="hero-label">不知不觉，我们已经一起走过</text
          ><view class="number">{{together}}<text>天</text></view
          ><text class="fineprint">从 {{startDate}} 开始，每天多一点喜欢。</text
          ><button
            class="relationship-settings"
            data-view="editor"
            data-kind="relationship"
            data-id="{{relationshipId}}"
            bindtap="navigate"
          >
            设置恋爱开始日期 ›</button
          ><view class="hero-footer"
            >故事还在继续<text>and counting…</text></view
          ></view
        >
        <view class="card mood-card"
          ><view class="section-title"
            >今日小心情<text>只展示主动分享的心情</text></view
          ><view class="mood-row"
            ><text>我</text><text class="bubble">{{myMood}}</text></view
          ><view class="mood-row"
            ><text>你</text
            ><text class="bubble lavender">{{partnerMood}}</text></view
          ><scroll-view scroll-x class="mood-options"
            ><text
              wx:for="{{moods}}"
              wx:key="*this"
              data-mood="{{item}}"
              bindtap="mood"
              >{{item}}</text
            ></scroll-view
          ></view
        >
        <view class="quick-grid"
          ><view data-view="editor" data-kind="memory" bindtap="navigate"
            ><text class="quick-symbol">✎</text><text>写一篇日记</text
            ><text class="tiny">留住今天的小美好</text></view
          ><view data-view="editor" data-kind="capsule" bindtap="navigate"
            ><text class="quick-symbol">✉</text><text>给未来的信</text
            ><text class="tiny">寄一份温柔的期待</text></view
          ><view bindtap="randomMemory"
            ><text class="quick-symbol">✧</text><text>随机一段回忆</text
            ><text class="tiny">重逢过去的某一天</text></view
          ><view data-view="pet" bindtap="navigate"
            ><text class="quick-symbol">♡</text><text>去糯米的小屋</text
            ><text class="tiny">毛茸茸的陪伴</text></view
          ></view
        >
        <view class="section-title section-gap"
          >最近的温柔时光<text data-page="memories" bindtap="navigate"
            >翻翻全部 →</text
          ></view
        ><view
          wx:for="{{recent}}"
          wx:key="id"
          class="card memory-card"
          data-view="detail"
          data-id="{{item.id}}"
          bindtap="navigate"
          ><image
            wx:if="{{item.coverPhotoUrl}}"
            src="{{item.coverPhotoUrl}}"
            class="memory-image"
            mode="aspectFill"
          /><view class="memory-content"
            ><view class="meta">{{item.data.date}} · 共同回忆</view
            ><view class="card-title">{{item.data.title}}</view
            ><view class="body-preview">{{item.data.body}}</view></view
          ></view
        ><view
          wx:if="{{!recent.length}}"
          class="empty"
          data-view="editor"
          bindtap="navigate"
          >空白的一页，也有无限可能。<view>写下第一条回忆 →</view></view
        >
        <view class="daily" data-view="question" bindtap="navigate"
          ><text class="eyebrow">A QUESTION FOR TODAY</text
          ><view>{{question}}</view><text>留下我的答案 →</text></view
        >
      </block>
      <block wx:if="{{page === 'memories'}}"
        ><view class="eyebrow">LITTLE MOMENTS, FOREVER MEMORIES</view
        ><view class="heading">时光慢慢，回忆满满<text>✳</text></view
        ><scroll-view scroll-x class="tabs"
          ><text
            class="{{screen === 'timeline' ? 'selected' : ''}}"
            data-view="timeline"
            bindtap="section"
            >时间轴</text
          ><text
            class="{{screen === 'album' ? 'selected' : ''}}"
            data-view="album"
            bindtap="section"
            >相册</text
          ><text
            class="{{screen === 'capsules' ? 'selected' : ''}}"
            data-view="capsules"
            bindtap="section"
            >时光胶囊</text
          ><text
            class="{{screen === 'map' ? 'selected' : ''}}"
            data-view="map"
            bindtap="section"
            >足迹</text
          ><text
            class="{{screen === 'report' ? 'selected' : ''}}"
            data-view="report"
            bindtap="section"
            >报告</text
          ><text
            class="{{screen === 'ai' ? 'selected' : ''}}"
            data-view="ai"
            bindtap="section"
            >AI 助手</text
          ></scroll-view
        ></block
      >
      <block wx:if="{{screen === 'timeline' || screen === 'album'}}"
        ><view class="filters"
          ><text
            data-filter="全部"
            bindtap="filter"
            class="{{filter === '全部' ? 'selected' : ''}}"
            >全部</text
          ><text
            data-filter="共同回忆"
            bindtap="filter"
            class="{{filter === '共同回忆' ? 'selected' : ''}}"
            >共同</text
          ><text
            data-filter="私人日记"
            bindtap="filter"
            class="{{filter === '私人日记' ? 'selected' : ''}}"
            >私人</text
          ><text
            data-filter="收藏"
            bindtap="filter"
            class="{{filter === '收藏' ? 'selected' : ''}}"
            >收藏</text
          ></view
        ><input
          class="search"
          value="{{search}}"
          data-field="search"
          bindinput="input"
          placeholder="在回忆里找一找：文字、日期、标签"
        />
        <button
          class="primary full"
          data-view="editor"
          data-kind="memory"
          bindtap="navigate"
        >
          ＋ 收藏今天的小事</button
        ><view wx:for="{{memories}}" wx:key="id" class="card memory-card"
          ><view data-view="detail" data-id="{{item.id}}" bindtap="navigate"
            ><image
              wx:if="{{item.coverPhotoUrl}}"
              src="{{item.coverPhotoUrl}}"
              class="memory-image"
              mode="aspectFill"
            /><view class="memory-content"
              ><view class="meta"
                >{{item.data.date}} · {{item.visibility === 'private' ?
                '仅自己可见' : '共同回忆'}}</view
              ><view class="card-title">{{item.data.title}}</view
              ><view wx:if="{{screen !== 'album'}}" class="body-preview"
                >{{item.data.body}}</view
              ><view class="tags"
                ><text wx:for="{{item.data.tags}}" wx:key="*this"
                  ># {{item}}</text
                ></view
              ></view
            ></view
          ><view class="card-footer"
            ><text data-id="{{item.id}}" bindtap="favorite">♡ 收藏 / 取消</text
            ><text
              data-view="editor"
              data-kind="memory"
              data-id="{{item.id}}"
              bindtap="navigate"
              >再添一笔 →</text
            ></view
          ></view
        ><view wx:if="{{!memories.length}}" class="empty"
          >还没有这一类回忆，先记下一条吧。</view
        ></block
      >
      <block wx:if="{{screen === 'editor'}}"
        ><view class="eyebrow">A LITTLE SOMETHING FOR US</view
        ><view class="heading"
          >{{form.category === 'relationship' ? '设置恋爱开始日期' :
          '记下这份温柔'}}<text>✳</text></view
        ><view class="card editor"
          ><block wx:if="{{form.category !== 'relationship'}}"
            ><text class="label">这一页的小标题</text
            ><input
              data-field="title"
              bindinput="formInput"
              value="{{form.title}}"
              placeholder="今天，有什么值得记住？"
              maxlength="80" /></block
          ><text class="label"
            >{{form.category === 'relationship' ? '恋爱开始日期' : form.kind ===
            'anniversary' ? '纪念日日期' : '记录日期'}}</text
          ><picker
            wx:if="{{form.category === 'relationship'}}"
            mode="date"
            end="{{day}}"
            value="{{form.date}}"
            data-field="date"
            bindchange="formInput"
            ><view class="picker">{{form.date}}</view></picker
          ><picker
            wx:else
            mode="date"
            value="{{form.date}}"
            data-field="date"
            bindchange="formInput"
            ><view class="picker">{{form.date}}</view></picker
          ><text wx:if="{{form.category === 'relationship'}}" class="fineprint"
            >恋爱开始当天记为第 1
            天。保存后，首页天数和恋爱纪念日倒计时都会自动更新。</text
          ><block wx:else
            ><text class="label">慢慢写，不用着急</text
            ><textarea
              data-field="body"
              bindinput="formInput"
              value="{{form.body}}"
              placeholder="或许只是一起喝了一杯咖啡，也很值得。"
              maxlength="12000"
              auto-height
            />
          </block>
          <block wx:if="{{form.kind === 'memory'}}"
            ><text class="label">小标签（用逗号分开）</text
            ><input
              data-field="tagsText"
              bindinput="input"
              value="{{tagsText}}"
              placeholder="日常，约会，小幸福"
            /><view class="switch-row"
              ><text>只有我自己可以看见</text
              ><switch
                checked="{{visibility === 'private'}}"
                disabled="{{busy || editing || form.photos.length > 0}}"
                color="#b48376"
                bindchange="visibility" /></view
            ><button
              class="secondary full"
              bindtap="addPhoto"
              disabled="{{busy || form.photos.length >= 6}}"
            >
              ＋ 添加照片 · 已选 {{form.photos.length || 0}} 张</button
            ><view class="editor-photos"
              ><view wx:for="{{editorPhotos}}" wx:key="id" class="editor-photo"
                ><image
                  wx:if="{{item.url}}"
                  src="{{item.url}}"
                  mode="aspectFill"
                  data-photo="{{item.id}}"
                  bindtap="previewPhoto"
                /><view wx:else class="photo-placeholder">照片暂时无法预览</view
                ><button
                  class="photo-remove"
                  data-photo="{{item.id}}"
                  bindtap="removePhoto"
                  disabled="{{busy}}"
                  aria-label="移除照片"
                >
                  ×
                </button></view
              ></view
            ><text wx:if="{{photoStatus}}" class="fineprint"
              >{{photoStatus}}</text
            ><text class="fineprint"
              >较大照片会自动缩小至 500 KB 以内，最多 6
              张；上传前在本机加密。</text
            ></block
          >
          <block wx:if="{{form.kind === 'capsule'}}"
            ><text class="label">约定开启的日子</text
            ><picker
              mode="date"
              start="{{day}}"
              value="{{form.unlockDate}}"
              data-field="unlockDate"
              bindchange="formInput"
              ><view class="picker">{{form.unlockDate}}</view></picker
            ><view class="switch-row"
              ><text>到期后，还需要双方确认</text
              ><switch
                checked="{{form.needsBoth}}"
                data-field="needsBoth"
                bindchange="formToggle"
                color="#b48376" /></view
            ><text class="fineprint"
              >日期开启是一份应用内的约定，并非密码学时间锁。</text
            ></block
          >
          <block wx:if="{{form.kind === 'place'}}"
            ><text class="label">城市 / 地点分类</text
            ><input
              value="{{form.city}}"
              data-field="city"
              bindinput="formInput"
              placeholder="文字地点也很好" /><input
              value="{{form.category}}"
              data-field="category"
              bindinput="formInput"
              placeholder="城市 / 旅行 / 餐厅 / 特别纪念" /><button
              class="secondary full"
              bindtap="chooseLocation"
            >
              主动在地图上选点（可选）</button
            ><text class="fineprint"
              >不会后台定位。仅在你主动选点时调用地图服务。</text
            ><text class="label">纬度 / 经度（可不填）</text
            ><input
              type="digit"
              value="{{form.latitude}}"
              data-field="latitude"
              bindinput="formInput" /><input
              type="digit"
              value="{{form.longitude}}"
              data-field="longitude"
              bindinput="formInput"
          /></block>
          <block wx:if="{{form.kind === 'wish'}}"
            ><text class="label">期待程度</text
            ><input
              value="{{form.priority}}"
              data-field="priority"
              bindinput="formInput"
              placeholder="小小期待 / 很想实现 / 慢慢来" /></block
          ><block
            wx:if="{{form.kind === 'anniversary' &amp;&amp; form.category !== 'relationship'}}"
            ><view class="switch-row"
              ><text>每一年，都想记住</text
              ><switch
                checked="{{form.yearly}}"
                data-field="yearly"
                bindchange="formToggle"
                color="#b48376" /></view></block
          ><block wx:if="{{form.kind === 'date'}}"
            ><text class="label">约会地点</text
            ><input
              value="{{form.location}}"
              data-field="location"
              bindinput="formInput" /><text class="label">大概预算（元）</text
            ><input
              type="digit"
              value="{{form.budget}}"
              data-field="budget"
              bindinput="formInput"
          /></block>
          <button
            class="primary full"
            bindtap="save"
            loading="{{busy}}"
            disabled="{{busy}}"
          >
            {{form.category === 'relationship' ? '保存恋爱开始日期' : form.kind
            === 'capsule' ? '封存这份期待' : '收藏到我们的小世界'}}</button
          ><text wx:if="{{form.category !== 'relationship'}}" class="fineprint"
            >日记草稿自动在本机加密保存。</text
          ></view
        ></block
      >
      <block wx:if="{{screen === 'detail' &amp;&amp; detail}}"
        ><view class="eyebrow">A MOMENT TO REMEMBER</view
        ><view class="heading">{{detail.data.title}}</view
        ><text class="subtitle"
          >{{detail.data.date}} · {{detail.visibility === 'private' ?
          '只有自己可见' : '共同回忆'}}</text
        ><view class="card"
          ><block wx:for="{{detail.photos}}" wx:key="id"
            ><image
              wx:if="{{item.url}}"
              src="{{item.url}}"
              class="detail-image"
              mode="widthFix"
              data-photo="{{item.id}}"
              bindtap="previewPhoto" /></block
          ><text class="detail-body" selectable>{{detail.data.body}}</text
          ><view class="tags"
            ><text wx:for="{{detail.data.tags}}" wx:key="*this"
              ># {{item}}</text
            ></view
          ><view wx:if="{{history.length}}" class="edit-history"
            ><view class="section-title">编辑历史 · 最近十次</view
            ><view wx:for="{{history}}" wx:key="at"
              ><text class="meta">{{item.time}}</text><view>{{item.title}}</view
              ><text class="subtitle">{{item.body}}</text></view
            ></view
          ><view class="card-footer"
            ><text
              data-view="editor"
              data-kind="{{detail.data.kind}}"
              data-id="{{detail.id}}"
              bindtap="navigate"
              >编辑这一页</text
            ><text data-id="{{detail.id}}" bindtap="trash"
              >移入回收站</text
            ></view
          ></view
        ><view class="card"
          ><view class="section-title">给这一页留句话</view
          ><view class="comment" wx:for="{{comments}}" wx:key="id"
            ><text>{{item.creatorId === userId ? '我' : '对方'}}</text
            >{{item.data.body}}</view
          ><input
            data-field="comment"
            bindinput="input"
            value="{{comment}}"
            placeholder="想说点什么…"
            maxlength="500"
          /><button
            class="secondary full"
            bindtap="comment"
            disabled="{{busy}}"
          >
            加密保存留言
          </button></view
        ></block
      >
      <block wx:if="{{screen === 'capsules'}}"
        ><view class="feature capsule-feature"
          ><text>✉</text><view>把现在，寄给未来的我们</view
          ><text class="subtitle">有些话，等到特别的日子再慢慢读。</text></view
        ><button
          class="primary full"
          data-view="editor"
          data-kind="capsule"
          bindtap="navigate"
        >
          ＋ 封存一份期待</button
        ><view wx:for="{{capsules}}" wx:key="id" class="card capsule"
          ><text class="eyebrow">TIME CAPSULE</text
          ><view class="card-title">{{item.data.title}}</view
          ><text class="subtitle">约定在 {{item.data.unlockDate}} 开启</text
          ><view class="capsule-days"
            >{{item.data.openedAt ? '已经开启' : item.remaining > 0 ? '还有 ' +
            item.remaining + ' 天' : '到了约定的日子'}}</view
          ><button
            wx:if="{{item.data.needsBoth &amp;&amp; !item.confirmed}}"
            class="secondary"
            data-id="{{item.id}}"
            data-action="confirm"
            bindtap="capsuleAction"
          >
            我准备好了</button
          ><button
            class="text-button"
            data-id="{{item.id}}"
            data-action="open"
            bindtap="capsuleAction"
          >
            {{item.data.openedAt ? '重读这封信' : '开启胶囊'}} →</button
          ><text class="tiny" data-id="{{item.id}}" bindtap="trash"
            >移入回收站</text
          ></view
        ><text class="fineprint"
          >日期开启由应用控制；拥有密钥的人理论上可以自行解密。</text
        ></block
      >
      <block wx:if="{{screen === 'map'}}"
        ><view class="feature map-feature"
          ><text>⌖</text><view>世界很大，想和你慢慢走</view
          ><text class="subtitle">只记录我们主动留下的足迹。</text></view
        ><button
          class="primary full"
          data-view="editor"
          data-kind="place"
          bindtap="navigate"
        >
          ＋ 留下新足迹</button
        ><view class="card" wx:for="{{places}}" wx:key="id"
          ><view class="meta">{{item.data.city}} · {{item.data.date}}</view
          ><view class="card-title">{{item.data.title}}</view
          ><text class="subtitle">{{item.data.body}}</text
          ><view class="card-footer"
            ><text data-id="{{item.id}}" bindtap="map">打开坐标地图</text
            ><text
              data-view="editor"
              data-kind="place"
              data-id="{{item.id}}"
              bindtap="navigate"
              >编辑足迹</text
            ></view
          ></view
        ><text class="fineprint"
